target/
# Skill distribution artifact (skills/ix packaged zip).
# Anchored: a bare `dist/` matches at any depth, which would also swallow
# ix-cli/dist and core-ingestion/dist — already ignored explicitly below, and
# better kept that way so the intent of each is visible.
/dist/

# Session/tooling artifacts (Freebuff preview state, generated knowledge graphs)
.freebuff/
.understand-anything/
.bsp/
.idea/
*.class
*.jar
.DS_Store
.worktrees/
node_modules/
ix-cli/node_modules/*
core-ingestion/node_modules/*
core-ingestion/dist/
ix-cli/dist/
ix-cli/coverage/
.vscode/
.mcp.json

# Local env files — may contain API keys / secrets. Commit .env.example
# with placeholder values if a template is needed.
.env
.env.*
!.env.example

# SBT boot artifacts
.sbt-boot/